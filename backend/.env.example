# SQLAlchemy connection string. Default is a local SQLite file; swap for
# a Postgres URL (e.g. postgresql://user:pass@db:5432/imagequality) if
# you add a Postgres service to docker-compose.yml.
DATABASE_URL=sqlite:///./data/analyses.db

# Where uploaded images are stored on disk (mounted as a volume in Docker
# so results survive container restarts).
UPLOAD_DIR=data/uploads

# Reject uploads larger than this before they're even decoded.
MAX_UPLOAD_MB=10

# Origin allowed to call the API directly (not needed for the Docker
# Compose setup, where nginx proxies same-origin, but used if you call
# the API directly from a different frontend host during development).
CORS_ORIGIN=http://localhost:5173
